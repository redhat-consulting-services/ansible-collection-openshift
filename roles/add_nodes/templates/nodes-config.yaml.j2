{% macro render_ipv4_block(addresses, dhcp) %}
          ipv4:
{% set ipv4_ns = namespace(found=false) %}
{% for address in addresses | default([]) %}
{% if ':' not in (address.ip | string) %}
{% if not ipv4_ns.found %}
{% set ipv4_ns.found = true %}
            enabled: true
            dhcp: false
            address:
{% endif %}
              - ip: {{ address.ip }}
                prefix-length: {{ address.subnet_length }}
{% endif %}
{% endfor %}
{% if not ipv4_ns.found %}
{% if dhcp | default(false) %}
            enabled: true
            dhcp: true
{% else %}
            enabled: false
{% endif %}
{% endif %}
{% endmacro %}

{% macro render_ipv6_block(addresses, dhcp) %}
          ipv6:
{% set ipv6_ns = namespace(found=false) %}
{% for address in addresses | default([]) %}
{% if ':' in (address.ip | string) %}
{% if not ipv6_ns.found %}
{% set ipv6_ns.found = true %}
            enabled: true
            dhcp: false
            autoconf: false
            address:
{% endif %}
              - ip: {{ address.ip }}
                prefix-length: {{ address.subnet_length }}
{% endif %}
{% endfor %}
{% if not ipv6_ns.found %}
{% if dhcp | default(false) %}
            enabled: true
            dhcp: true
{% else %}
            enabled: false
{% endif %}
{% endif %}
{% endmacro %}
cpuArchitecture: {{ cpu_architecture | default('amd64') }}
{# check if the NTP sources have been defined #}
{% if additional_ntp_sources is defined %}
additionalNTPSources: {{ additional_ntp_sources }}
{% endif %}

hosts:
{%- for hosts in worker.get('hosts', []) %}
  {%- set host_index = loop %}

  - role: worker
    hostname: {{ hosts.hostname | mandatory }}
    rootDeviceHints:
{% if hosts.root_device.name is defined %}
      deviceName: {{ hosts.root_device.name }}
{% else %}
{% if hosts.root_device.serial_number is not defined and hosts.root_device.wwn is not defined %}
      deviceName: {{ worker.root_device_name }}
{% endif %}
{% endif %}
{% if hosts.root_device.serial_number is defined %}
      serialNumber: {{ hosts.root_device.serial_number }}
{% endif %}
{% if hosts.root_device.wwn is defined %}
      wwn: {{ hosts.root_device.wwn }}
{% endif %}

{#- interfaces config #}
    interfaces:
{% for interface in hosts.interfaces %}
      - name: {{ interface.name }}
        macAddress: {{ interface.mac_address }}
{% endfor %}
    networkConfig:
      dns-resolver:
        config:
          server:
{% for resolver in worker.dns_resolvers | default([]) %}
            - {{ resolver }}
{% endfor %}
      routes:
        config:
{% for route in worker.routes | default([]) %}
          - destination: {{ route.destination }}
            next-hop-address: {{ route.gateway }}
            next-hop-interface: {{ route.interface }}
            table-id: {{ route.table_id }}
{% endfor %}
      interfaces:
{# ensure all interfaces are up and running #}
{% for interface in hosts.interfaces %}
        - name: {{ interface.name }}
          type: ethernet
          state: up
{% if interface.mtu is defined %}
          mtu: {{ interface.mtu }}
{% endif %}
{{ render_ipv4_block(interface.addresses, interface.ipv4_dhcp) }}
{{ render_ipv6_block(interface.addresses, interface.ipv6_dhcp) }}
{% endfor %}
{# ------------------------------------ #}
{#       generate bond interface        #}
{# ------------------------------------ #}
{% if worker.bonds is defined %}
{% for bond in worker.bonds %}
        - name: {{ bond.name }}
          type: bond
          state: up
          link-aggregation:
            mode: {{ bond.mode }}
            port:
{% for interface in hosts.interfaces %}
{% if interface.part_of_bond == bond.name %}
              - {{ interface.name }}
{% endif %}
{% endfor %}
{% if bond.options is defined %}
            options:
              {{ bond.options | to_nice_yaml(indent=14) | indent(14) -}}
{% endif %}
{% if hosts.bonds is not defined %}
{# worker.bonds is defined but worker.hosts[].bonds is not #}
{# if that is the case, we want to use DHCP for bond ipv4 assignment #}
{{ render_ipv4_block([], true) }}
{{ render_ipv6_block([], false) }}
{% else %}
{# worker.bonds is defined and worker.hosts[].bonds is defined #}
{# if that is the case, we want to take control over ipv4 assignments (manually configure ip addresses) #}
{% set bond_ns = namespace(configured=false) %}
{% for hbond in hosts.bonds %}
{% if bond.name == hbond.interface %}
{% set bond_ns.configured = true %}
{{ render_ipv4_block(hbond.addresses, hbond.ipv4_dhcp | default(false)) }}
{{ render_ipv6_block(hbond.addresses, hbond.ipv6_dhcp | default(false)) }}
{% endif %}
{% endfor %}
{% if not bond_ns.configured %}
{{ render_ipv4_block([], false) }}
{{ render_ipv6_block([], false) }}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
{# ------------------------------------ #}
{#      generate bridge interface       #}
{# ------------------------------------ #}
{% if worker.bridges is defined %}
{% for bridge in worker.bridges %}
        - name: {{ bridge.name }}
          state: up
          type: {{ bridge.type }}
          port:
{% for interface in bridge.interfaces %}
            - name: {{ interface.name }}
{% endfor %}
          bridge:
            allow-extra-patch-ports: true
{% if bridge.options is defined %}
            options:
              {{ bridge.options | to_nice_yaml(indent=14) | indent(14) }}
{% endif %}
{% endfor %}
{% endif %}
{# ------------------------------------ #}
{#       generate vlan interface        #}
{# ------------------------------------ #}
{% if worker.vlans is defined %}
{% for vlan in worker.vlans %}
        - name: {{ vlan.name }}
          type: vlan
          state: up
          vlan:
            base-iface: {{ vlan.base_interface }}
            id: {{ vlan.id }}
{% if hosts.vlans is defined %}
{% set vlan_ns = namespace(hvlan=none) %}
{% for hvlan in hosts.vlans %}
{% if vlan.name == hvlan.interface %}
{% set vlan_ns.hvlan = hvlan %}
{% endif %}
{% endfor %}
{% if vlan_ns.hvlan %}
{{ render_ipv4_block(vlan_ns.hvlan.addresses, vlan_ns.hvlan.ipv4_dhcp | default(false)) }}
{{ render_ipv6_block(vlan_ns.hvlan.addresses, vlan_ns.hvlan.ipv6_dhcp | default(false)) }}
{% else %}
{{ render_ipv4_block([], false) }}
{{ render_ipv6_block([], false) }}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}

{# endfor for worker.hosts #}
{% endfor %}
